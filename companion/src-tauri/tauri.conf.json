{
  "productName": "UrApex",
  "identifier": "com.urapex.companion",
  "version": "0.4.1",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "perMachine"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDExMUM4RDgzMzVCNjEyOUQKUldTZEVyWTFnNDBjRVY3blltZFU1KzBrS053OTFhZTlha0haUzZVM3FOVFBrYWhsQXgyaTcvZUcK",
      "endpoints": [
        "https://github.com/AdriiBC02/UrApex/releases/download/companion-latest/latest.json"
      ]
    }
  }
}
