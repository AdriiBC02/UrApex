# ── Database ──────────────────────────────────────────────────────────────────
# Local dev
DATABASE_URL="postgresql://urapex:urapex_dev@localhost:5432/urapex"

# Neon (production): use the pooled URL for the app
# DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL used by `prisma migrate deploy` only (bypasses PgBouncer)
# DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# ── Auth.js ───────────────────────────────────────────────────────────────────
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
# Production: AUTH_URL="https://your-domain.vercel.app"

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_PROVIDER="local"
STORAGE_LOCAL_PATH="./storage"

# Cloudflare R2 (when STORAGE_PROVIDER=s3)
# STORAGE_PROVIDER="s3"
# S3_BUCKET="urapex-uploads"
# S3_REGION="auto"
# S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
# S3_ACCESS_KEY="<R2 Access Key ID>"
# S3_SECRET_KEY="<R2 Secret Access Key>"

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"
# Upstash (production): REDIS_URL="rediss://:<token>@<host>.upstash.io:6379"

# ── Cron (Vercel) ─────────────────────────────────────────────────────────────
# Protects /api/cron/process-imports — generate with: openssl rand -hex 32
# CRON_SECRET=""

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── AI Coach (Phase 6+) ───────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=""
